@page "/"
@using DevExpress.Blazor.Internal
@using DevExpress.Images.Blazor.Internal
@layout MainLayout

@inject DemoConfiguration Configuration
@inject NavigationManager NavigationManager
@inject DemoThemeService Themes

@{
    RenderFragment<DemoProductInfo> DemoComponentTile = (info) =>
    @<a class="demo-product" href="@info.PageUri">
        <div class="demo-product-icon">
            <span class="@info.IconKey"></span>
        </div>
        <span>@info.Title</span>
    </a>;

    RenderFragment<DemoRwaInfo> DemoApplicationTile = (info) =>
    @<a class="demo-rwa mb-4" href="@info.PageUri">
        <div class="demo-rwa-image">
            <img src="@(StaticAssetUtils.GetImagePath(info.ImagePath))" alt="" />
        </div>
        <div class="demo-rwa-text">
            <div>
                <span class="demo-rwa-title">@info.Title</span>
                <span class="demo-rwa-info">@info.Description</span>
            </div>
        </div>
    </a>;
}
<div class="demo-products demo-products-description theme-@Themes.ActiveTheme.Name.Replace(" ", "-")">
    <h1 class="mb-4">DevExpress UI Components for Blazor</h1>
    <p>The <a href="https://www.devexpress.com/blazor/" target="_blank">DevExpress Blazor UI component suite</a> ships with a comprehensive suite of Blazor components (including a DataGrid, Scheduler, Chart, Data Editors, Rich Text Editor, and Reporting). To learn more about the capabilities of our Blazor UI suite for your next great Blazor-based web app, select a component library from the list below. DevExpress Blazor UI components ship as part of the DevExpress ASP.NET, DXperience, and Universal Subscriptions.</p>
    <p>Should you have any questions about the products listed herein or are considering DevExpress UI components for an upcoming Blazor project, please email <a href="mailto:info@devexpress.com" tabindex="-1">info@devexpress.com</a>. We will be happy to follow-up.</p>
    <h2 class="mb-4">Components</h2>
    <div class="demo-products-container mb-4">
        @foreach (var info in Configuration.Products)
        {
            @DemoComponentTile.Invoke(info)
        }
    </div>
    <h2 class="mb-4">Application</h2>
    <div class="mb-4">
        @foreach (var info in Configuration.RwaDemos)
        {
            @DemoApplicationTile.Invoke(info)
        }
    </div>
</div>


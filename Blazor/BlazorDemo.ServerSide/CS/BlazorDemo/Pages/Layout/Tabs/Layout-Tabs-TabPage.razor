<DemoPageSectionComponent Id="Layout-Tabs-TabPage" ShowSizeMode="true">
    <ChildContentWithParameters Context="Params">
        @inject NwindDataService NwindDataService

        @if(Employees == null) {
            <p><em>Loading...</em></p>
        } else {
            <div class="w-100 chi-220">
                <DxTabs SizeMode="Params.SizeMode" CssClass="demo-tabs-employees">
                    @foreach(var employee in Employees) {
                        <DxTabPage Text="@(employee.FirstName + ' ' + employee.LastName)">
                            <div class="d-flex pt-2 demo-employee-card">
                                <div class="flex-shrink-0">
                                    <img src="@(StaticAssetUtils.GetEmployeeImagePath(employee.EmployeeId))" width="125" alt="@(employee.FullName + " photo")" />
                                </div>
                                <div class="flex-grow-1 ps-3">
                                    <div class="h5">@employee.Title @employee.FirstName @employee.LastName</div>
                                    <p><b>Birthday:</b> @employee.BirthDate?.ToShortDateString()</p>
                                    <p>@employee.Notes</p>
                                </div>
                            </div>
                        </DxTabPage>
                    }
                </DxTabs>
            </div>
        }

        @code {
            IEnumerable<Employee> Employees;

            protected override async Task OnInitializedAsync() {
                Employees = (await NwindDataService.GetEmployeesAsync()).Skip(5).Take(3);
            }

        }
    </ChildContentWithParameters>
</DemoPageSectionComponent>

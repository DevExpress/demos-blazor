<DemoPageSectionComponent Id="DialogsAndWindows-MessageBox-DialogService" ShowSizeMode="true">
    <ChildContentWithParameters Context="Params">
        <div class="d-flex flex-column align-items-center justify-content-center p-3">
            <DxButton RenderStyle="ButtonRenderStyle.Secondary" Click="OpenConfirmDialogAsync">CLICK TO SHOW A MESSAGE BOX</DxButton>
            <p>RETURN VALUE: @(Result is not null ? Result.ToString().ToUpper() : "NO VALUE")</p>
        </div>
        <DxDialogProvider SizeMode="@Params.SizeMode"/>
    </ChildContentWithParameters>
    @code {
        [Inject] IDialogService DialogService { get; set; }

        private bool? Result { get; set; } = null;

        private async Task OpenConfirmDialogAsync() {
            Result = await DialogService.ConfirmAsync(
                new MessageBoxOptions() {
                    Title = "Confirm Deletion",
                    OkButtonText = "Delete",
                    CancelButtonText = "Cancel",
                    RenderStyle = MessageBoxRenderStyle.Danger
                },
                @<div>
                    <p>The following files will be permanently deleted:</p>
                    <ul>
                        <li>report_2025.pdf</li>
                        <li>invoice_march.xlsx</li>
                        <li>backup_data.zip</li>
                    </ul>
                    <p>This action cannot be undone.</p>
                </div>
            );
        }
    }
</DemoPageSectionComponent>

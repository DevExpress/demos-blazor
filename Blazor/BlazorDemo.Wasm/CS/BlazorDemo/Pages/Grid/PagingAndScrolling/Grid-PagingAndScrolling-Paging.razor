@page "/Grid/PagingAndScrolling/Paging"
@layout DataProviderAccessArea<INwindDataProvider>

<DemoPageSectionComponent Id="Grid-PagingAndScrolling-Paging" ShowSizeMode="true">
    <ChildContentWithParameters Context="Params">
        @inject NwindDataService NwindDataService

        <div class="grid-container">
            <DxGrid Data="@DataSource"
                    PageSize="20"
                    PagerPosition="@CurrentPagerPosition"
                    PageSizeSelectorVisible="@PageSizeSelectorVisible"
                    PageSizeSelectorItems="@(new int[] { 10, 20, 100 })"
                    PageSizeSelectorAllRowsItemVisible="true"
                    PagerNavigationMode="@CurrentPagerNavigationMode"
                    PagerSummaryVisible="@PagerSummaryVisible"
                    PagerSwitchToInputBoxButtonCount="10"
                    PagerVisibleNumericButtonCount="10"
                    ColumnResizeMode="GridColumnResizeMode.NextColumn"
                    TextWrapEnabled="false"
                    SizeMode="Params.SizeMode">
                <Columns>
                    <DxGridDataColumn FieldName="ShipName" MinWidth="100" />
                    <DxGridDataColumn FieldName="ShipCity" Width="15%" />
                    <DxGridDataColumn FieldName="ShipPostalCode" Width="10%" />
                    <DxGridDataColumn FieldName="ShipCountry" Width="15%" />
                    <DxGridDataColumn FieldName="Freight" Width="10%" />
                    <DxGridDataColumn FieldName="OrderDate" Width="10%" MinWidth="80" />
                    <DxGridDataColumn FieldName="ShippedDate" Width="10%" MinWidth="80" />
                </Columns>
                <ToolbarTemplate>
                    <DxToolbar ItemRenderStyleMode="ToolbarRenderStyleMode.Plain" SizeMode="Params.SizeMode">
                        <Items>
                            <DxToolbarItem Alignment="ToolbarItemAlignment.Left">
                                <Template Context="toolbar_item_context">
                                    <div class="ms-2 me-2">
                                        <DxCheckBox @bind-Checked="PageSizeSelectorVisible">Page Size Selector</DxCheckBox>
                                    </div>
                                </Template>
                            </DxToolbarItem>
                            <DxToolbarItem Alignment="ToolbarItemAlignment.Left">
                                <Template Context="toolbar_item_context">
                                    <div class="ms-2 me-2">
                                        <DxCheckBox @bind-Checked="PagerSummaryVisible">Summary</DxCheckBox>
                                    </div>
                                </Template>
                            </DxToolbarItem>
                            <DxToolbarItem Alignment="ToolbarItemAlignment.Left">
                                <Template Context="toolbar_item_context">
                                    <div class="d-flex flex-row align-items-center ms-2 me-2">
                                        <div id="pager-navigation-mode-label" class="me-2">Navigation Controls:</div>
                                        <DxComboBox @bind-Value="CurrentPagerNavigationMode"
                                                    Data="@(Enum.GetValues<PagerNavigationMode>())"
                                                    aria-labelledby="pager-navigation-mode-label"/>
                                    </div>
                                </Template>
                            </DxToolbarItem>
                            <DxToolbarItem Alignment="ToolbarItemAlignment.Left">
                                <Template Context="toolbar_item_context">
                                    <div class="d-flex flex-row align-items-center ms-2 me-2">
                                        <div id="pager-position-label" class="me-2">Position:</div>
                                        <DxComboBox @bind-Value="CurrentPagerPosition"
                                                    Data="@(Enum.GetValues<GridPagerPosition>())"
                                                    aria-labelledby="pager-position-label"/>
                                    </div>
                                </Template>
                            </DxToolbarItem>
                        </Items>
                    </DxToolbar>
                </ToolbarTemplate>
            </DxGrid>
        </div>
    </ChildContentWithParameters>

    @code {
        IEnumerable<Order> DataSource { get; set; }
        GridPagerPosition CurrentPagerPosition { get; set; } = GridPagerPosition.Bottom;
        bool PageSizeSelectorVisible { get; set; } = true;
        PagerNavigationMode CurrentPagerNavigationMode { get; set; } = PagerNavigationMode.NumericButtons;
        bool PagerSummaryVisible { get; set; } = true;

        protected override async Task OnInitializedAsync() {
            DataSource = await NwindDataService.GetOrdersAsync();
        }
    }
</DemoPageSectionComponent>
